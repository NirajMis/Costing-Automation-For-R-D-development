# Copy this file to .env and fill in once your Basis/IT team confirms
# SAP Business One Service Layer access. Until B1_MOCK_MODE=false, the
# server ignores everything below and serves realistic mock data instead,
# so the portal's fetch buttons work end-to-end right now.

PORT=4000

# Set to false only after B1_SERVICE_LAYER_URL / COMPANY_DB / USERNAME /
# PASSWORD are filled in AND you've confirmed Service Layer is reachable
# (see README.md "Going live against real SAP B1" section).
B1_MOCK_MODE=true

# Example: https://sap-b1-server.yourcompany.local:50000/b1s/v1
B1_SERVICE_LAYER_URL=

# The exact CompanyDB name as it appears in the SAP B1 login screen
B1_COMPANY_DB=

# A dedicated SERVICE ACCOUNT — do not use a personal SAP B1 login.
# Ask your Basis/IT admin to create one scoped to read-only where possible.
B1_USERNAME=
B1_PASSWORD=

# Most SAP B1 test/on-prem servers use a self-signed certificate.
# Set to false ONLY for a trusted internal network during setup/testing;
# set to true (the secure default) once a proper certificate is in place.
B1_TLS_REJECT_UNAUTHORIZED=true

# ---- Business-specific mapping — CONFIRM these with your SAP B1 / Basis
# team, they are assumptions until validated against your real B1 setup ----

# Which SAP B1 Price List (OPLN.ListNum) represents "PriceListRate" in the
# portal's RATE MASTER logic. Find it in SAP B1: Inventory > Price Lists.
B1_PRICE_LIST_ID=1

# Item Group code (OITB.ItmsGrpCod) that identifies Finished Goods (FGs) —
# used to decide which Items/ProductTrees are "FG" tabs vs sub-assemblies/
# components. Find it in SAP B1: Inventory > Item Groups.
B1_FG_ITEM_GROUP_CODE=

# How many days back to look for GRPO (Goods Receipt PO) receipts when
# building GRPORate/LatestGRPODate — should match RATE MASTER's own
# 365-day window, but kept separate here in case your Basis team wants a
# wider pull window for performance/caching reasons.
B1_GRPO_LOOKBACK_DAYS=400

# Comma-separated list of CORS origins allowed to call this backend —
# add the URL the portal (index.html) is actually served from.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
